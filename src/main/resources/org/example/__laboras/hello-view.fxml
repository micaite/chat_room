<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.__laboras.HelloController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Host:"/>
    <TextField fx:id="hostField" text="localhost"/>

    <Label text="Port:"/>
    <TextField fx:id="portField" text="5000"/>

    <Label text="Username:"/>
    <TextField fx:id="usernameField" promptText="Enter username..."/>

    <Button text="Connect" onAction="#onConnectClick"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
</VBox>